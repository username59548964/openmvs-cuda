+// OPENMVS_RESUME_GEOMETRIC : resume the geometric-consistent iterations after an interruption;
+// state kept in depth-geo.txt (working folder) : "<iter> running", "<iter> renaming" or "<iter> done"
+namespace {
+bool ResumeGeometricEnabled() {
+	const char* v(getenv("OPENMVS_RESUME_GEOMETRIC"));
+	return v != NULL && *v != '\0' && *v != '0';
+}
+String GeometricStateFile() { return MAKE_PATH("depth-geo.txt"); }
+void WriteGeometricState(int iter, const char* state) {
+	if (!ResumeGeometricEnabled())
+		return;
+	const String name(GeometricStateFile()), tmp(name+".tmp");
+	{ std::ofstream f(tmp.c_str(), std::ios::trunc); f << iter << ' ' << state << '\n'; }
+	File::deleteFile(name);
+	File::renameFile(tmp, name);
+}
+bool ReadGeometricState(int& iter, std::string& state) {
+	std::ifstream f(GeometricStateFile().c_str());
+	return (bool)(f >> iter >> state);
+}
+// replace the raw depth-maps with the geometric-consistent ones (only those written)
+void ReplaceWithGeometric(const MVS::Scene& scene, const IIndexArr& images) {
+	for (IIndex idx: images) {
+		const String geoName(ComposeDepthFilePath(scene.images[idx].ID, "geo.dmap"));
+		if (!File::access(geoName))
+			continue;
+		const String rawName(ComposeDepthFilePath(scene.images[idx].ID, "dmap"));
+		File::deleteFile(rawName);
+		File::renameFile(geoName, rawName);
+	}
+}
+std::atomic<unsigned> g_rawEstimated{0}; // raw depth-maps written by this run
+bool g_resumeIter = false; // current geometric iteration resumed : depth-maps already written are kept
+} // namespace
+
 
