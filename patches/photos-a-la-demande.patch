+// OPENMVS_LAZY_IMAGES : images loaded on demand (photo and neighbors only)
+#include <mutex>
+#include <list>
+#include <atomic>
+#include <cstdlib>
+namespace MVS {
+struct LazyImages {
+	bool active = false;
+	size_t capacity = 24;
+	std::mutex mtx;
+	std::vector<unsigned> maxRes;
+	std::vector<int> pins;
+	std::list<IIndex> lru;
+	Image* base = nullptr;
+	size_t count = 0;
+	LazyImages() {
+		const char* v = std::getenv("OPENMVS_LAZY_IMAGES");
+		if (v != nullptr) {
+			active = true;
+			const long n = std::atol(v);
+			if (n > 0)
+				capacity = (size_t)n;
+		}
+	}
+	void Init(ImageArr& images) {
+		std::lock_guard<std::mutex> l(mtx);
+		base = images.data();
+		count = images.size();
+		maxRes.assign(count, 0);
+		pins.assign(count, 0);
+		lru.clear();
+	}
+	void SetResolution(IIndex i, unsigned r) {
+		std::lock_guard<std::mutex> l(mtx);
+		if (i < maxRes.size())
+			maxRes[i] = r;
+	}
+	IIndex Index(const Image* p) const { return (IIndex)(p - base); }
+	void Evict() {
+		for (auto it = lru.begin(); lru.size() > capacity && it != lru.end(); ) {
+			if (pins[*it] == 0) {
+				base[*it].ReleaseImage();
+				it = lru.erase(it);
+			} else
+				++it;
+		}
+	}
+	// load (if needed) and pin the image; returns false if it can not be read
+	bool Acquire(const Image* p) {
+		if (!active || base == nullptr)
+			return true;
+		const IIndex i = Index(p);
+		if (i >= count)
+			return true;
+		std::lock_guard<std::mutex> l(mtx);
+		Image& im = base[i];
+		lru.remove(i);
+		if (im.image.empty() && !im.ReloadImage(maxRes[i], true))
+			return false;
+		lru.push_back(i);
+		++pins[i];
+		Evict();
+		return true;
+	}
+	void Release(const Image* p) {
+		if (!active || base == nullptr)
+			return;
+		const IIndex i = Index(p);
+		if (i >= count)
+			return;
+		std::lock_guard<std::mutex> l(mtx);
+		if (pins[i] > 0)
+			--pins[i];
+		Evict();
+	}
+};
+static LazyImages g_lazyImages;
+static std::atomic<unsigned> g_lazySkipped{0}; // neighbor depth-maps not cached during fusion (ignored)
+static size_t g_lazyCacheMax = 0; // largest depth-map cache allowed during fusion (bytes)
+// gray copy of an image loaded on demand
+static inline void LazyToGray(const Image* p, Image32F& gray) {
+	g_lazyImages.Acquire(p);
+	p->image.toGray(gray, cv::COLOR_BGR2GRAY, true);
+	g_lazyImages.Release(p);
+}
